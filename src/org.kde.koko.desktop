# InitialPreference should be greater than Okular so that Koko is the
# primary application associated with images, but less than Konqueror or Dolphin
# so that Koko is not the primary applications for folders.
# This is intionally the same value Gwenview uses as Koko is about en par.
InitialPreference=8
